{
  "name": "carepatron-chatgpt-plugin",
  "version": "1.0.0",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc",
    "check-links": "tsx scripts/check-links.ts",
    "tunnel": "ngrok http --url=$PUBLIC_HOST 127.0.0.1:${PORT:-8787}",
    "inspect": "npx @modelcontextprotocol/inspector@latest",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "description": "Demo ChatGPT plugin: finds Carepatron clinical document templates",
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jaxirb/carepatron-chatgpt-plugin"
  },
  "license": "MIT"
}
